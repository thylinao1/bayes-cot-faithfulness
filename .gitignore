# experiment run artifacts: bulk ignored, but the positive-control evidence the
# README cites (the verified 8B real-model run) is tracked so the repo is
# self-contained and the silent-unfaithful transcripts can be re-scored offline.
experiments/results/*
!experiments/results/control_summary_llama-3.1-8b-instant.json
!experiments/results/control_transcripts_llama-3.1-8b-instant.json
!experiments/results/silent_unfaithful_llama-3.1-8b-instant.json
# committed audit artifacts (T9 parser audit, T10 power artifact); labelset and
# every labeling file stay ignored for rater blinding.
!experiments/results/guardrail_power_artifacts.json
!experiments/results/parser_audit_sample.tsv
# exploratory additive-arms smoke summaries (no verdict; transcripts stay local)
!experiments/results/arms_summary_llama3.2_3b.json
!experiments/results/arms_summary_llama-3.3-70b-versatile.json
# first PREREGISTERED sweep summary (all 8 arms, ARC-130, stated-hint); the power
# artifact ingests it and it accompanies the run. Transcripts stay local (bulky).
!experiments/results/arms_summary_llama-3.1-8b-instant.json
# A9 specificity pilot summary (the pilots/ dir itself stays ignored otherwise)
!experiments/results/pilots/
experiments/results/pilots/*
!experiments/results/pilots/arms_summary_llama3.2_3b.json
# P8 cue-taxonomy sweeps (one dir per family so summaries never clobber): the
# summary and its judgment-free numbers table are committed, transcripts and
# checkpoints stay local like every other run.
!experiments/results/p8_professor/
experiments/results/p8_professor/*
!experiments/results/p8_professor/arms_summary_llama-3.1-8b-instant.json
!experiments/results/p8_professor/numbers_table.txt
!experiments/results/p8_metadata/
experiments/results/p8_metadata/*
!experiments/results/p8_metadata/arms_summary_llama-3.1-8b-instant.json
!experiments/results/p8_metadata/numbers_table.txt
!experiments/results/p8_grader_code/
experiments/results/p8_grader_code/*
!experiments/results/p8_grader_code/arms_summary_llama-3.1-8b-instant.json
!experiments/results/p8_grader_code/numbers_table.txt
# powered P3 run on AQuA-RAT (Amendment A1); summary + numbers table committed,
# transcripts and checkpoint stay local like every other run
!experiments/results/p3_powered_aqua/
experiments/results/p3_powered_aqua/*
!experiments/results/p3_powered_aqua/arms_summary_llama-3.1-8b-instant.json
!experiments/results/p3_powered_aqua/numbers_table.txt
experiments/data/arc_*.json
# P3 candidate-substrate fetches (gitignored like the ARC fetches; the runner
# fingerprints their sha256 in its checkpoint params, and committing LogiQA 2.0
# data would also be a CC BY-NC-SA redistribution question; see the memo)
experiments/data/logiqa2*.json
experiments/data/aqua*.json

# R session history from exploratory analysis in experiments/
experiments/.Rhistory
