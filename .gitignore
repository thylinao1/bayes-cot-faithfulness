# experiment run artifacts: bulk ignored, but the positive-control evidence the
# README cites (the verified 8B real-model run) is tracked so the repo is
# self-contained and the silent-unfaithful transcripts can be re-scored offline.
experiments/results/*
!experiments/results/control_summary_llama-3.1-8b-instant.json
!experiments/results/control_transcripts_llama-3.1-8b-instant.json
!experiments/results/silent_unfaithful_llama-3.1-8b-instant.json
# committed audit artifacts (T9 parser audit, T10 power artifact); labelset and
# every labeling file stay ignored for rater blinding.
!experiments/results/guardrail_power_artifacts.json
!experiments/results/parser_audit_sample.tsv
# exploratory additive-arms smoke summaries (no verdict; transcripts stay local)
!experiments/results/arms_summary_llama3.2_3b.json
!experiments/results/arms_summary_llama-3.3-70b-versatile.json
# first PREREGISTERED sweep summary (all 8 arms, ARC-130, stated-hint); the power
# artifact ingests it and it accompanies the run. Transcripts stay local (bulky).
!experiments/results/arms_summary_llama-3.1-8b-instant.json
# A9 specificity pilot summary (the pilots/ dir itself stays ignored otherwise)
!experiments/results/pilots/
experiments/results/pilots/*
!experiments/results/pilots/arms_summary_llama3.2_3b.json
# P8 cue-taxonomy sweeps (one dir per family so summaries never clobber): the
# summary and its judgment-free numbers table are committed, transcripts and
# checkpoints stay local like every other run.
!experiments/results/p8_professor/
experiments/results/p8_professor/*
!experiments/results/p8_professor/arms_summary_llama-3.1-8b-instant.json
!experiments/results/p8_professor/numbers_table.txt
!experiments/results/p8_metadata/
experiments/results/p8_metadata/*
!experiments/results/p8_metadata/arms_summary_llama-3.1-8b-instant.json
!experiments/results/p8_metadata/numbers_table.txt
!experiments/results/p8_grader_code/
experiments/results/p8_grader_code/*
!experiments/results/p8_grader_code/arms_summary_llama-3.1-8b-instant.json
!experiments/results/p8_grader_code/numbers_table.txt
# powered P3 run on AQuA-RAT (Amendment A1); summary + numbers table committed,
# transcripts and checkpoint stay local like every other run
!experiments/results/p3_powered_aqua/
experiments/results/p3_powered_aqua/*
!experiments/results/p3_powered_aqua/arms_summary_llama-3.1-8b-instant.json
!experiments/results/p3_powered_aqua/numbers_table.txt
# Phase-1 skeleton and anchor-validation cells on the cluster: the four small,
# machine-generated artifacts per cell are committed so a verifier can recompute a rate
# without cluster access; transcripts, checkpoints and server logs stay local like every
# other run. Each level needs its own un-ignore because the parent rule ends in /*.
!experiments/results/phase1-skeleton/
experiments/results/phase1-skeleton/**
!experiments/results/phase1-skeleton/**/
!experiments/results/phase1-skeleton/**/arms_summary.json
!experiments/results/phase1-skeleton/**/run_meta.json
!experiments/results/phase1-skeleton/**/throughput.json
!experiments/results/phase1-skeleton/**/logprob_check.json
!experiments/results/phase1-skeleton/**/exit_code.txt
# The 47-record Qwen3-8B ARC stated-hint transcript bank of the Phase-1 skeleton is tracked
# because the jury gate corpus (experiments/jury/gate_corpus_manifest.json, 483 items) is
# rebuilt from it in CI; 30 ARC items as run records, the same fair-use footing as the
# w3b-skeleton records below.
!experiments/results/phase1-skeleton/**/transcripts.jsonl
!experiments/results/phase1-anchor-mig/
experiments/results/phase1-anchor-mig/**
!experiments/results/phase1-anchor-mig/**/
!experiments/results/phase1-anchor-mig/**/arms_summary.json
!experiments/results/phase1-anchor-mig/**/run_meta.json
!experiments/results/phase1-anchor-mig/**/throughput.json
!experiments/results/phase1-anchor-mig/**/logprob_check.json
!experiments/results/phase1-anchor-mig/**/exit_code.txt
# The W3b skeleton (job 826025): the first run carrying the element 9.2 sampling arm and
# the element 8.3 repeated curves. The per-item RECORDS are kept, not just the summary,
# because A3.3 to A3.5 are recomputed from them and a 30-item cell's transcripts are a
# few megabytes. The three substrate pools stay gitignored; nothing here redistributes
# ARC items beyond the 30 this cell used, which is fair-use quotation of a CC BY-SA set
# inside a run record rather than a copy of the dataset.
!experiments/results/w3b-skeleton/
experiments/results/w3b-skeleton/**
!experiments/results/w3b-skeleton/**/
!experiments/results/w3b-skeleton/**/*.json
!experiments/results/w3b-skeleton/**/*.jsonl
!experiments/results/w3b-skeleton/**/exit_code.txt
!experiments/results/w3b-skeleton/**/run.log
!experiments/results/w3b-skeleton/**/server-backend-lines.txt

# CPU mechanism battery (A2 element 11(a)): the report, the aggregated results, the
# cross-checks, the PyMC subset and the per-dataset rows are all committed, because the
# whole artifact is CPU-reproducible from one command and a verifier recomputes the
# rates from the rows. conditions_partial.json is a crash-safety duplicate and stays local.
!experiments/results/mechanism_battery/
experiments/results/mechanism_battery/*
!experiments/results/mechanism_battery/report.md
!experiments/results/mechanism_battery/battery_results.json
!experiments/results/mechanism_battery/cross_checks.json
!experiments/results/mechanism_battery/pymc_subset.json
!experiments/results/mechanism_battery/dataset_rows.csv
# The 2026-09-07 acceptance gate for the scale-aware priors (W4c): the same seeds and the
# same datasets as the battery's own subset, run on their own so the gate has an artifact
# of its own rather than only a line in a log. One command reproduces it:
# `python experiments/mechanism_battery.py --only-pymc --out <dir>`.
!experiments/results/mechanism_battery_pymc_gate/
experiments/results/mechanism_battery_pymc_gate/*
!experiments/results/mechanism_battery_pymc_gate/pymc_subset.json
!experiments/results/mechanism_battery_pymc_gate/pymc_only_summary.json
experiments/data/arc_*.json
# P3 candidate-substrate fetches (gitignored like the ARC fetches; the runner
# fingerprints their sha256 in its checkpoint params, and committing LogiQA 2.0
# data would also be a CC BY-NC-SA redistribution question; see the memo)
experiments/data/logiqa2*.json
experiments/data/aqua*.json

# R session history from exploratory analysis in experiments/
experiments/.Rhistory

# W6 external validity: FaithCoT-Bench third-party data, evaluation only, never redistributed
experiments/data/external/

# Wave-1 column A / column B fits (lane A, 2026-09-07): the offset-null gate record and
# one fit.json + pymc.json per usable cell. Small aggregates only; no transcripts.
!experiments/results/wave1-fits/
experiments/results/wave1-fits/*
!experiments/results/wave1-fits/offset_null_gate.json
!experiments/results/wave1-fits/*/
experiments/results/wave1-fits/*/*
!experiments/results/wave1-fits/*/fit.json
!experiments/results/wave1-fits/*/pymc.json
